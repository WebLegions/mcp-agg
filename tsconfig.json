{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "target": "es2022",
    "lib": ["es2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "inlineSources": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "ci/**/*",
    "script/*"
  ],
  "exclude": [
    "node_modules"
  ]
}